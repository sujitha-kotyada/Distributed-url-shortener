# Application Environment
# Options: development, staging, production
# When set to production, startup validation enforces strong JWT secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
BASE_URL=http://localhost:8001
LOAD_BALANCER_HOST_PORT=8001

# PostgreSQL Configuration
POSTGRES_DB=url_shortener
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://url_shortener:change-me@localhost:5432/url_shortener

# Redis Configuration
# Published port binds to 127.0.0.1 by default in docker-compose.yml.
# For production, do not expose Redis to public networks; use authentication and TLS.
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.5

# Analytics Stream & Worker Configuration
ANALYTICS_STREAM_NAME=url_shortener:redirect_events
ANALYTICS_CONSUMER_GROUP=url_shortener:redirect_analytics
ANALYTICS_CONSUMER_NAME=worker-1
ANALYTICS_READ_BLOCK_MS=1000
ANALYTICS_SOCKET_TIMEOUT_SECONDS=5.0
ANALYTICS_BATCH_SIZE=10
ANALYTICS_CLAIM_IDLE_MS=60000
ANALYTICS_STREAM_MAXLEN=100000
ANALYTICS_DLQ_STREAM_NAME=url_shortener:redirect_events:dlq
ANALYTICS_MAX_RETRIES=3

# Security & Authentication
# In production, JWT_SECRET_KEY is required, cannot use dev default, and must be >= 32 characters.
JWT_SECRET_KEY=change-me-to-a-super-secret-key-with-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Trusted Proxies (JSON array or comma-separated list of IP/CIDR strings)
# When set, X-Forwarded-For is validated against these proxy networks.
# In Docker Compose with Nginx reverse proxy, use ["172.16.0.0/12"] or ["127.0.0.1"].
TRUSTED_PROXIES=[]

# Rate Limiting
RATE_LIMIT_URL_CREATION_PER_MINUTE=20
RATE_LIMIT_REDIRECT_PER_MINUTE=100

# CORS Configuration
# In production, list only trusted frontend origins (e.g., ["https://shortener.example.com"]).
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8001"]

# Monitoring & Grafana
# Sets the initial Grafana administrator password. Published to 127.0.0.1:3001 by default.
# DEVELOPMENT-ONLY PLACEHOLDER: Replace this placeholder with a secure password in .env before starting containers.
# Note: For production, configure HTTPS, SSO/OAuth, and persistent storage.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-dev-password-replace-before-use
